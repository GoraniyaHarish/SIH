# Copy to .env and fill in. Never commit real values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://pramana:CHANGE_ME@127.0.0.1:5432/pramana
JWT_SECRET=replace-with-64-random-bytes
# Required only when running backend/seed.py; use a unique local-only value.
DEMO_PASSWORD=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379/0

# AI provider (OpenAI-compatible). Blank = extractive fallback mode.
# Sending document/query text to an external provider requires explicit opt-in.
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536
AI_SEND_DOCUMENTS_EXTERNALLY=false

# Integration adapters — blank = honest "not configured"
IGOT_BASE_URL=
IGOT_API_TOKEN=
NSSTA_BASE_URL=
NSSTA_API_TOKEN=
